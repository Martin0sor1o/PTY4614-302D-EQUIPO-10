# Copiar a .env (cp .env.example .env). Nunca subir .env al repositorio. Sin valores reales aquí: el repositorio es público.
# Inventario completo de variables, quién las maneja y cómo rotarlas: docs/CREDENCIALES.md
DATABASE_URL="postgresql://bigcurvas:bigcurvas@localhost:5432/big_curvas?schema=public"
# Solo en hosting con pooler (Neon): DATABASE_URL = cadena pooled (host con "-pooler"; la usa la app) y
# DIRECT_URL = cadena directa (la usan prisma migrate deploy y el seed del CLI). Ambas con sslmode=require.
# Localmente se omite DIRECT_URL y se usa DATABASE_URL.
# DIRECT_URL="postgresql://USUARIO:CLAVE@HOST_DIRECTO/BD?sslmode=require"
# BD usada por los tests de integración (Vitest)
TEST_DATABASE_URL="postgresql://bigcurvas:bigcurvas@localhost:5432/big_curvas_test?schema=public"

# AUTENTICACIÓN REAL. Secreto del servidor (mínimo 32 caracteres) para las huellas HMAC de intentos fallidos y de la auditoría.
# Genera uno propio: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
# Cada entorno (local, Render) tiene el suyo; si se cambia, los contadores de intentos se reinician (no cierra sesiones).
# AUTH_SECRET=

# DEMO: habilita el login sin contraseña ("Entrar como…") y el botón de reinicio de datos.
# En un despliegue real debe ser false u omitirse: sin DEMO_MODE=true no existen el login demo ni los PIN demo.
DEMO_MODE=true
# DEMO: false = la primera siembra y el reinicio de datos NO cargan el historial de ventas (más rápido; los reportes quedan vacíos).
# Por omisión se carga el historial.
# DEMO_SEED_HISTORY=false
# DEMO: PIN de aprobación presencial de Belén en la demo (4 a 6 dígitos que tú eliges; NO lo escribas en el repositorio ni en
# los docs). Solo se lee con DEMO_MODE=true: lo usa el seed y lo muestra la pantalla como pista. Sin él, Belén queda sin PIN en
# la demo y la aprobación remota sigue funcionando.
# DEMO_ADMIN_PIN=

# NO van en .env ni en Render/Neon: AUTH_INITIAL_PASSWORD y AUTH_INITIAL_PIN (los scripts auth:create-admin, auth:reset-password y
# auth:create-user las leen SOLO de la terminal donde se corren, o piden la clave con un prompt oculto).
