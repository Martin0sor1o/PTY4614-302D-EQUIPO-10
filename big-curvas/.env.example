# Copiar a .env (cp .env.example .env). Nunca subir .env al repositorio.
DATABASE_URL="postgresql://bigcurvas:bigcurvas@localhost:5432/big_curvas?schema=public"
# BD usada por los tests de integración (Vitest)
TEST_DATABASE_URL="postgresql://bigcurvas:bigcurvas@localhost:5432/big_curvas_test?schema=public"

# DEMO: habilita el login sin contraseña ("Entrar como…") y el botón de reinicio de datos.
# En un despliegue real debe ser false u omitirse.
DEMO_MODE=true
# DEMO: false = la primera siembra y el reinicio de datos NO cargan el historial de ventas (más rápido; los reportes quedan vacíos).
# Por omisión se carga el historial.
# DEMO_SEED_HISTORY=false
